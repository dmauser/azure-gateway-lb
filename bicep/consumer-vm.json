{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "10608611478722491273"
    }
  },
  "parameters": {
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Admin username for the VM."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Admin password for the VM. Azure requires 12-72 chars with uppercase, lowercase, digit, and special character. Passed as @secure() — not stored in deployment history."
      }
    },
    "virtualMachineName": {
      "type": "string",
      "defaultValue": "consumer-vm",
      "metadata": {
        "description": "Consumer VM name."
      }
    },
    "virtualMachineSize": {
      "type": "string",
      "defaultValue": "Standard_B1s",
      "metadata": {
        "description": "VM size. Standard_B1s is sufficient for the nginx lab workload."
      }
    },
    "existingVNetName": {
      "type": "string",
      "defaultValue": "consumer-vnet",
      "metadata": {
        "description": "Existing VNet name in this resource group (created by deploy.azcli step 1)."
      }
    },
    "existingSubnetName": {
      "type": "string",
      "defaultValue": "vmsubnet",
      "metadata": {
        "description": "Existing subnet name within the VNet (created by deploy.azcli step 1)."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[parameters('virtualMachineName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "virtualMachineName": {
            "value": "[parameters('virtualMachineName')]"
          },
          "virtualMachineSize": {
            "value": "[parameters('virtualMachineSize')]"
          },
          "subnetId": {
            "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', split(format('{0}/{1}', parameters('existingVNetName'), parameters('existingSubnetName')), '/')[0], split(format('{0}/{1}', parameters('existingVNetName'), parameters('existingSubnetName')), '/')[1])]"
          },
          "adminUsername": {
            "value": "[parameters('adminUsername')]"
          },
          "adminPassword": {
            "value": "[parameters('adminPassword')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "8008392266145109726"
            }
          },
          "parameters": {
            "virtualMachineName": {
              "type": "string",
              "defaultValue": "consumer-vm",
              "metadata": {
                "description": "Consumer VM name."
              }
            },
            "virtualMachineSize": {
              "type": "string",
              "defaultValue": "Standard_B1s",
              "metadata": {
                "description": "VM size. Standard_B1s is sufficient for the nginx test workload."
              }
            },
            "subnetId": {
              "type": "string",
              "metadata": {
                "description": "Subnet resource ID for the consumer VM NIC."
              }
            },
            "adminUsername": {
              "type": "string",
              "metadata": {
                "description": "Admin username for the VM."
              }
            },
            "adminPassword": {
              "type": "securestring",
              "metadata": {
                "description": "Admin password for the VM. Azure requires 12-72 chars with uppercase, lowercase, digit, and special character. Passed as @secure() — not stored in deployment history."
              }
            },
            "nsgId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Optional NSG resource ID to attach to the NIC. Leave empty to rely on subnet-level NSG."
              }
            }
          },
          "variables": {
            "$fxv#0": "#cloud-config\r\npackage_update: true\r\npackage_upgrade: false\r\npackages:\r\n  - nginx\r\nwrite_files:\r\n  - path: /var/www/html/index.html\r\n    content: \"Test Website on consumer-vm\\n\"\r\n    owner: www-data:www-data\r\n    permissions: '0644'\r\nruncmd:\r\n  - systemctl enable nginx\r\n  - systemctl start nginx\r\n",
            "cloudInitData": "[base64(variables('$fxv#0'))]",
            "nicName": "[format('{0}-nic', parameters('virtualMachineName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Network/networkInterfaces",
              "apiVersion": "2023-09-01",
              "name": "[variables('nicName')]",
              "location": "[resourceGroup().location]",
              "properties": {
                "networkSecurityGroup": "[if(empty(parameters('nsgId')), null(), createObject('id', parameters('nsgId')))]",
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "subnet": {
                        "id": "[parameters('subnetId')]"
                      },
                      "privateIPAllocationMethod": "Dynamic"
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Compute/virtualMachines",
              "apiVersion": "2024-03-01",
              "name": "[parameters('virtualMachineName')]",
              "location": "[resourceGroup().location]",
              "properties": {
                "osProfile": {
                  "computerName": "[parameters('virtualMachineName')]",
                  "adminUsername": "[parameters('adminUsername')]",
                  "adminPassword": "[parameters('adminPassword')]",
                  "customData": "[variables('cloudInitData')]"
                },
                "hardwareProfile": {
                  "vmSize": "[parameters('virtualMachineSize')]"
                },
                "storageProfile": {
                  "osDisk": {
                    "createOption": "FromImage",
                    "managedDisk": {
                      "storageAccountType": "Premium_LRS"
                    }
                  },
                  "imageReference": {
                    "publisher": "Canonical",
                    "offer": "0001-com-ubuntu-server-jammy",
                    "sku": "22_04-lts-gen2",
                    "version": "latest"
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]",
                      "properties": {
                        "primary": true
                      }
                    }
                  ]
                },
                "securityProfile": {
                  "securityType": "TrustedLaunch",
                  "uefiSettings": {
                    "secureBootEnabled": true,
                    "vTpmEnabled": true
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
              ]
            }
          ],
          "outputs": {
            "nicName": {
              "type": "string",
              "value": "[variables('nicName')]"
            },
            "nicId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicName'))]"
            },
            "privateIP": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Network/networkInterfaces', variables('nicName')), '2023-09-01').ipConfigurations[0].properties.privateIPAddress]"
            },
            "vmId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Compute/virtualMachines', parameters('virtualMachineName'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "nicName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', parameters('virtualMachineName')), '2025-04-01').outputs.nicName.value]"
    },
    "nicId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', parameters('virtualMachineName')), '2025-04-01').outputs.nicId.value]"
    },
    "privateIP": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', parameters('virtualMachineName')), '2025-04-01').outputs.privateIP.value]"
    },
    "vmId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', parameters('virtualMachineName')), '2025-04-01').outputs.vmId.value]"
    }
  }
}